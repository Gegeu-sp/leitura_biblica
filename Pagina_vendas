// Mostrar seção
function showSection(id) {
  document.querySelectorAll('.section').forEach(s => s.classList.add('hidden'));
  const target = document.getElementById(id);
  if (target) {
    target.classList.remove('hidden');
    target.classList.remove('fade-in');
    void target.offsetWidth;
    target.classList.add('fade-in');
  }
  
  // Atualizar tabs
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('tab-active'));
  document.querySelectorAll('.tab-btn').forEach(b => {
    if (b.getAttribute('onclick') === `showSection('${id}')`) {
      b.classList.add('tab-active');
    }
  });
  
  // Atualizar progresso
  const stepMap = {
    'filosofia': 1, 'saudacao': 2, 'storytelling': 3,
    'argumentacao': 4, 'objecoes': 5, 'cenarios': 6, 'fechamento': 7, 'simulador': 0
  };
  const step = stepMap[id] || 0;
  if (step > 0) {
    currentStep = step;
    updateProgress();
  }
  
  // Scroll suave pro topo
  window.scrollTo({ top: 0, behavior: 'smooth' });
  
  // Inicializar simulador se necessário
  if (id === 'simulador') {
    initChat();
  }
}

// Atualizar progresso
function updateProgress() {
  document.querySelectorAll('.progress-step').forEach(s => {
    const step = parseInt(s.getAttribute('data-step'));
    s.classList.remove('active', 'completed');
    if (step < currentStep) s.classList.add('completed');
    else if (step === currentStep) s.classList.add('active');
  });
  document.getElementById('progressText').textContent = `Etapa ${currentStep} de 7`;
}

// Copiar texto (com fallback)
function copyText(id, btn) {
  const el = document.getElementById(id);
  if (!el) return;
  
  const text = el.innerText;
  
