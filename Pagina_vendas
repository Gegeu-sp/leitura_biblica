// Checklist
function toggleChecklist() {
  const panel = document.getElementById('checklistPanel');
  panel.classList.toggle('hidden');
}

function toggleChecklistItem(id) {
  checklistState[id] = !checklistState[id];
  localStorage.setItem('checklistState', JSON.stringify(checklistState));
  renderChecklist();
}

function resetChecklist() {
  checklistState = {};
  localStorage.setItem('checklistState', JSON.stringify(checklistState));
  renderChecklist();
  showToast('Checklist reiniciado!');
}

function renderChecklist() {
  const container = document.getElementById('checklistItems');
  container.innerHTML = '';
  let checked = 0;
  
  checklistItems.forEach(item => {
    const isChecked = checklistState[item.id];
    if (isChecked) checked++;
    
    const div = document.createElement('div');
    div.className = `checklist-item flex items-center gap-3 p-2 rounded-lg border border-gray-700 cursor-pointer ${isChecked ? 'checked' : ''}`;
    div.onclick = () => toggleChecklistItem(item.id);
    div.innerHTML = `
      <div class="check-box w-5 h-5 rounded border-2 border-gray-600 flex items-center justify-center transition">
        ${isChecked ? '<span class="text-white text-xs">✓</span>' : ''}
      </div>
      <span class="check-text text-sm flex-1">${item.text}</span>
      <button onclick="event.stopPropagation(); showSection('${item.section}')" class="text-xs text-orange-400 hover:text-orange-300">→</button>
    `;
    container.appendChild(div);
  });
  
  document.getElementById('checklistCount').textContent = `${checked}/7`;
}

