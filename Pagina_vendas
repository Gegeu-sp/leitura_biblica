  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text).then(() => {
      showToast('Copiado para a área de transferência!');
      if (btn) animateCopyBtn(btn);
    }).catch(() => {
      fallbackCopy(text, btn);
    });
  } else {
    fallbackCopy(text, btn);
  }
}

function fallbackCopy(text, btn) {
  const textarea = document.createElement('textarea');
  textarea.value = text;
  textarea.style.position = 'fixed';
  textarea.style.opacity = '0';
  document.body.appendChild(textarea);
  textarea.select();
  try {
    document.execCommand('copy');
    showToast('Copiado!');
    if (btn) animateCopyBtn(btn);
  } catch (err) {
    showToast('Erro ao copiar');
  }
  document.body.removeChild(textarea);
}

function animateCopyBtn(btn) {
  const original = btn.innerHTML;
  btn.innerHTML = '✓ Copiado!';
  btn.style.background = '#22c55e';
  btn.style.color = 'white';
  setTimeout(() => {
    btn.innerHTML = original;
    btn.style.background = '';
    btn.style.color = '';
  }, 1500);
}

// Toast
function showToast(message) {
  const toast = document.getElementById('toast');
  document.getElementById('toastMessage').textContent = message;
  toast.classList.remove('translate-y-20', 'opacity-0');
  setTimeout(() => {
    toast.classList.add('translate-y-20', 'opacity-0');
  }, 2000);
}

// Toggle accordion
function toggleAccordion(i) {
  const content = document.getElementById(`content-${i}`);
  const arrow = document.getElementById(`arrow-${i}`);
  content.classList.toggle('open');
  arrow.style.transform = content.classList.contains('open') ? 'rotate(180deg)' : 'rotate(0)';
}

// Toggle scenario
function toggleScenario(id) {
  const expanded = document.getElementById(`scenario-expanded-${id}`);
  const arrow = document.getElementById(`scenario-arrow-${id}`);
