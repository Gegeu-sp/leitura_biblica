// Simulador
function initChat() {
  currentChatStep = 0;
  renderChat();
}

function resetChat() {
  currentChatStep = 0;
  renderChat();
}

function loadScenarioInSimulator(id) {
  currentChatFlow = id;
  currentChatStep = 0;
  document.getElementById('scenarioSelect').value = id;
  showSection('simulador');
  renderChat();
}

function renderChat() {
  const flow = chatFlows[currentChatFlow];
  if (!flow) return;
  
  const chatWindow = document.getElementById('chatWindow');
  const suggestions = document.getElementById('chatSuggestions');
  chatWindow.innerHTML = '';
  suggestions.innerHTML = '';
  
  // Mostrar mensagens até o passo atual
  for (let i = 0; i <= currentChatStep && i < flow.length; i++) {
    const msg = flow[i];
    const bubble = document.createElement('div');
    
    if (msg.type === 'system') {
      bubble.className = 'text-center text-xs text-gray-500 py-2';
      bubble.textContent = msg.text;
    } else if (msg.type === 'consultant') {
      bubble.className = 'chat-bubble flex gap-2';
      bubble.innerHTML = `
        <div class="w-8 h-8 bg-orange-500 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0">C</div>
        <div class="bg-orange-500/20 border border-orange-500/30 rounded-2xl rounded-tl-sm px-4 py-2 max-w-md">
          <p class="text-sm text-gray-200">${msg.text}</p>
        </div>
      `;
    } else if (msg.type === 'lead') {
      bubble.className = 'chat-bubble flex gap-2 justify-end';
      bubble.innerHTML = `
        <div class="bg-gray-800 border border-gray-700 rounded-2xl rounded-tr-sm px-4 py-2 max-w-md">
          <p class="text-sm text-gray-200">${msg.text}</p>
        </div>
        <div class="w-8 h-8 bg-gray-600 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0">L</div>
      `;
    } else if (msg.type === 'success') {
      bubble.className = 'chat-bubble bg-green-500/20 border border-green-500/50 rounded-xl p-4 text-center';
      bubble.innerHTML = `<p class="text-green-400 font-bold">${msg.text}</p>`;
    }
    
    chatWindow.appendChild(bubble);
  }
  
  // Mostrar sugestões se o passo atual é uma suggestion
  const currentMsg = flow[currentChatStep];
  if (currentMsg && currentMsg.type === 'suggestion') {
    currentMsg.options.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = 'bg-gray-800 hover:bg-orange-500 border border-gray-700 hover:border-orange-500 transition p-3 rounded-xl text-sm text-left';
      btn.textContent = opt.text;
      btn.onclick = () => {
        if (opt.next === 'fail') {
          showFailState();
        } else {
          currentChatStep = opt.next;
          renderChat();
        }
      };
      suggestions.appendChild(btn);
    });
  }
  
  chatWindow.scrollTop = chatWindow.scrollHeight;
}

function showFailState() {
  const chatWindow = document.getElementById('chatWindow');
  const suggestions = document.getElementById('chatSuggestions');
  
  const bubble = document.createElement('div');
  bubble.className = 'chat-bubble bg-red-500/20 border border-red-500/50 rounded-xl p-4 text-center';
  bubble.innerHTML = `
    <p class="text-red-400 font-bold mb-2">❌ Oportunidade perdida!</p>
    <p class="text-sm text-gray-300">O lead não se sentiu acolhido e perdeu o interesse.</p>
  `;
  chatWindow.appendChild(bubble);
  
  suggestions.innerHTML = `
    <button onclick="resetChat()" class="bg-orange-500 hover:bg-orange-600 transition text-white font-semibold py-3 rounded-xl text-sm col-span-2">🔄 Tentar novamente</button>
  `;
  
  chatWindow.scrollTop = chatWindow.scrollHeight;
}

// Busca
document.getElementById('searchInput').addEventListener('input', function(e) {
  const query = e.target.value.toLowerCase().trim();
  if (!query) {
    // Remover highlights
    document.querySelectorAll('.search-highlight').forEach(el => {
      el.outerHTML = el.textContent;
    });
    return;
  }
  
  // Procurar nas seções
  const sections = {
    'filosofia': ['filosofia', 'mentalidade', 'consultor', 'acolhimento', 'segurança'],
    'saudacao': ['saudação', 'saudacao', 'tratativa', 'olá', 'quebra de gelo'],
    'storytelling': ['storytelling', 'história', 'narrativa', 'mariana'],
    'argumentacao': ['argumentação', 'argumentacao', 'pilares', 'orange zone', 'monitoramento'],
    'objecoes': ['objeção', 'objecoes', 'tempo', 'caro', 'medo', 'pensar'],
    'cenarios': ['cenário', 'cenarios', 'perfil', 'emagrecimento', 'estressado'],
    'fechamento': ['fechamento', 'cta', 'pré-cadastro', 'despedida']
  };
  
  for (const [section, keywords] of Object.entries(sections)) {
    if (keywords.some(k => k.includes(query) || query.includes(k))) {
      showSection(section);
      break;
    }
  }
});

// Select do simulador
document.getElementById('scenarioSelect').addEventListener('change', function(e) {
  currentChatFlow = e.target.value;
  currentChatStep = 0;
  renderChat();
});

// ============ INICIALIZAÇÃO ============
document.addEventListener('DOMContentLoaded', function() {
  renderObjections();
  renderScenarios();
  renderChecklist();
  updateProgress();
});
</script>

