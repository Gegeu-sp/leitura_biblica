</nav>

<!-- CHECKLIST PANEL -->
<div id="checklistPanel" class="fixed top-20 right-4 w-80 bg-gray-900 rounded-2xl p-5 border border-gray-800 shadow-2xl z-40 hidden">
  <div class="flex items-center justify-between mb-4">
    <h3 class="font-bold text-orange-400">✓ Checklist do Atendimento</h3>
    <button onclick="toggleChecklist()" class="text-gray-400 hover:text-white">✕</button>
  </div>
