<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Roteiro de Vendas | Cia Athletica Mooca</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/inter@5.0.0/index.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/space-grotesk@5.0.0/index.css">
<style>
  * { font-family: 'Inter', sans-serif; }
  h1, h2, h3, h4, .brand { font-family: 'Space Grotesk', sans-serif; }
  
  .gradient-bg {
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 50%, #ff6b00 100%);
  }
  
  .card-hover {
    transition: all 0.3s ease;
  }
  .card-hover:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 40px rgba(255, 107, 0, 0.2);
  }
  
  .accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
  }
  .accordion-content.open {
    max-height: 2000px;
  }
  
  .tab-active {
    background: #ff6b00 !important;
    color: white !important;
    border-color: #ff6b00 !important;
  }
  
  .copy-btn {
    transition: all 0.2s;
  }
  .copy-btn:hover {
    background: #ff6b00 !important;
    color: white !important;
  }
  
  .fade-in {
    animation: fadeIn 0.5s ease-in;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .pulse-dot {
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  
  .scenario-card {
    border-left: 4px solid #ff6b00;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .scenario-card:hover {
    background: rgba(255, 107, 0, 0.05);
  }
  
  .scenario-expanded {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s ease, margin-top 0.3s ease;
  }
  .scenario-expanded.open {
    max-height: 1500px;
    margin-top: 1rem;
  }
  
  .chat-bubble {
    animation: slideIn 0.3s ease;
  }
  @keyframes slideIn {
    from { opacity: 0; transform: translateX(-10px); }
    to { opacity: 1; transform: translateX(0); }
  }
  
  .progress-step {
    transition: all 0.3s ease;
  }
  .progress-step.active {
    background: #ff6b00;
    color: white;
    transform: scale(1.1);
  }
  .progress-step.completed {
    background: #22c55e;
    color: white;
  }
  
  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-track { background: #1a1a1a; }
  ::-webkit-scrollbar-thumb { background: #ff6b00; border-radius: 4px; }
  
  .search-highlight {
    background: rgba(255, 107, 0, 0.3);
    padding: 2px 4px;
    border-radius: 3px;
  }
  
  .typing-indicator span {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: #ff6b00;
    border-radius: 50%;
    margin: 0 2px;
    animation: typing 1.4s infinite;
  }
  .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
  .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes typing {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30% { transform: translateY(-8px); opacity: 1; }
  }
  
  .checklist-item {
    transition: all 0.2s ease;
  }
  .checklist-item.checked {
    background: rgba(34, 197, 94, 0.1);
    border-color: #22c55e !important;
  }
  .checklist-item.checked .check-box {
    background: #22c55e;
    border-color: #22c55e;
  }
  .checklist-item.checked .check-text {
    text-decoration: line-through;
    color: #9ca3af;
  }
</style>
</head>
<body class="bg-gray-950 text-gray-100 min-h-screen">

<!-- HEADER -->
<header class="gradient-bg sticky top-0 z-50 border-b border-orange-500/30">
  <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between flex-wrap gap-3">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-orange-500 rounded-lg flex items-center justify-center font-bold text-xl brand">C</div>
      <div>
        <h1 class="text-xl font-bold brand">CIA ATHLETICA MOOCA</h1>
        <p class="text-xs text-orange-300">Roteiro de Vendas Consultivas • 2026</p>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <div class="hidden md:flex items-center gap-2 bg-gray-900/50 rounded-full px-3 py-1.5 border border-gray-700">
        <input type="text" id="searchInput" placeholder="🔍 Buscar..." class="bg-transparent text-sm outline-none w-40 text-gray-200 placeholder-gray-500">
      </div>
      <button onclick="toggleChecklist()" class="bg-gray-900/50 hover:bg-orange-500 transition px-3 py-1.5 rounded-full text-sm border border-gray-700 flex items-center gap-2">
        <span>✓</span>
        <span class="hidden sm:inline">Checklist</span>
        <span id="checklistCount" class="bg-orange-500 text-white text-xs px-1.5 py-0.5 rounded-full">0/7</span>
      </button>
      <div class="flex items-center gap-2 text-sm">
        <span class="w-2 h-2 bg-green-400 rounded-full pulse-dot"></span>
        <span class="text-gray-300 hidden sm:inline">Equipe Comercial</span>
      </div>
    </div>
  </div>
</header>

<!-- HERO -->
<section class="max-w-7xl mx-auto px-4 py-10 text-center">
  <h2 class="text-3xl md:text-5xl font-bold mb-4 brand">
    Do <span class="text-orange-500">Produto</span> à <span class="text-orange-500">Metodologia</span>
  </h2>
  <p class="text-gray-400 max-w-2xl mx-auto text-base md:text-lg">
    Guia completo para conversão de novos alunos com foco em acolhimento, resultados mensuráveis e prova concreta de evolução.
  </p>
  <div class="flex flex-wrap justify-center gap-2 mt-6">
    <button onclick="showSection('filosofia')" class="bg-gray-900 border border-gray-800 hover:border-orange-500 rounded-full px-4 py-2 text-sm transition">🎯 Venda Consultiva</button>
    <button onclick="showSection('argumentacao')" class="bg-gray-900 border border-gray-800 hover:border-orange-500 rounded-full px-4 py-2 text-sm transition">💓 Monitoramento Cardíaco</button>
    <button onclick="showSection('argumentacao')" class="bg-gray-900 border border-gray-800 hover:border-orange-500 rounded-full px-4 py-2 text-sm transition">📊 Resultados Mensuráveis</button>
    <button onclick="showSection('saudacao')" class="bg-gray-900 border border-gray-800 hover:border-orange-500 rounded-full px-4 py-2 text-sm transition">🤝 Acolhimento</button>
  </div>
</section>

<!-- PROGRESS BAR -->
<div class="max-w-7xl mx-auto px-4 mb-6">
  <div class="bg-gray-900 rounded-2xl p-4 border border-gray-800">
    <div class="flex items-center justify-between mb-3">
      <h4 class="text-sm font-semibold text-gray-300">Progresso do Atendimento</h4>
      <span id="progressText" class="text-xs text-orange-400">Etapa 0 de 7</span>
    </div>
    <div class="flex items-center justify-between gap-1">
      <button onclick="showSection('filosofia')" class="progress-step flex-1 bg-gray-800 rounded-lg py-2 text-xs font-medium" data-step="1">🧠 Filosofia</button>
      <button onclick="showSection('saudacao')" class="progress-step flex-1 bg-gray-800 rounded-lg py-2 text-xs font-medium" data-step="2">👋 Saudação</button>
      <button onclick="showSection('storytelling')" class="progress-step flex-1 bg-gray-800 rounded-lg py-2 text-xs font-medium" data-step="3">📖 Story</button>
      <button onclick="showSection('argumentacao')" class="progress-step flex-1 bg-gray-800 rounded-lg py-2 text-xs font-medium" data-step="4">🎯 Argum.</button>
      <button onclick="showSection('objecoes')" class="progress-step flex-1 bg-gray-800 rounded-lg py-2 text-xs font-medium" data-step="5">🛡️ Objeç.</button>
      <button onclick="showSection('cenarios')" class="progress-step flex-1 bg-gray-800 rounded-lg py-2 text-xs font-medium" data-step="6">🎭 Cenár.</button>
      <button onclick="showSection('fechamento')" class="progress-step flex-1 bg-gray-800 rounded-lg py-2 text-xs font-medium" data-step="7">✅ Fech.</button>
    </div>
  </div>
</div>

<!-- TABS NAVIGATION -->
<nav class="max-w-7xl mx-auto px-4 mb-6">
  <div class="flex flex-wrap gap-2 justify-center">
    <button onclick="showSection('filosofia')" class="tab-btn tab-active px-4 py-2 rounded-full text-sm font-medium bg-gray-800 border border-gray-700 transition">🧠 Filosofia</button>
    <button onclick="showSection('saudacao')" class="tab-btn px-4 py-2 rounded-full text-sm font-medium bg-gray-800 border border-gray-700 transition">👋 Saudação</button>
    <button onclick="showSection('storytelling')" class="tab-btn px-4 py-2 rounded-full text-sm font-medium bg-gray-800 border border-gray-700 transition">📖 Storytelling</button>
    <button onclick="showSection('argumentacao')" class="tab-btn px-4 py-2 rounded-full text-sm font-medium bg-gray-800 border border-gray-700 transition">🎯 Argumentação</button>
    <button onclick="showSection('objecoes')" class="tab-btn px-4 py-2 rounded-full text-sm font-medium bg-gray-800 border border-gray-700 transition">🛡️ Objeções</button>
    <button onclick="showSection('cenarios')" class="tab-btn px-4 py-2 rounded-full text-sm font-medium bg-gray-800 border border-gray-700 transition">🎭 Cenários</button>
    <button onclick="showSection('fechamento')" class="tab-btn px-4 py-2 rounded-full text-sm font-medium bg-gray-800 border border-gray-700 transition">✅ Fechamento</button>
    <button onclick="showSection('simulador')" class="tab-btn px-4 py-2 rounded-full text-sm font-medium bg-gray-800 border border-gray-700 transition">💬 Simulador</button>
